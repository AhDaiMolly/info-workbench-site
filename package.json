{
  "name": "info-workbench-site",
  "private": true,
  "version": "6.1.1",
  "description": "信息汇总工作台 · 公开站点仓（零数据）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "check:no-data": "node scripts/check-no-data.mjs"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.0.1",
    "@types/node": "^20.19.43",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
